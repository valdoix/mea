{
  "name": "mea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mea: a personal AI roleplay frontend with deep memory.",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun --watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && bun scripts/gen-icons.ts --check",
    "start": "bun server/src/index.ts",
    "build:exe": "bun scripts/build-exe.ts",
    "test": "bun test server/test",
    "check": "tsc --noEmit -p server/tsconfig.json && svelte-check --workspace web --tsconfig ./tsconfig.json --threshold warning",
    "budgets": "bun scripts/check-budgets.ts",
    "golden": "bun scripts/golden.ts",
    "icons": "bun scripts/gen-icons.ts",
    "app:desktop": "cd desktop && tauri build",
    "app:android": "cd mobile && bun install && bun run apk"
  },
  "dependencies": {
    "@fontsource-variable/alegreya": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/crimson-pro": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/neonderthaw": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "gpt-tokenizer": "^4.0.0",
    "hono": "^4.13.13",
    "marked": "^18.1.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@lucide/svelte": "^1.53.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "2",
    "@types/bun": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "harper.js": "2.10.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6",
    "vite": "^8.3.3"
  }
}
